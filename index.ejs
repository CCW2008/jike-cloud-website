  <button id="chatButton" class="fixed bottom-6 right-6 w-14 h-14 rounded-full bg-secondary text-white flex items-center justify-center shadow-lg hover:bg-tertiary transition-all z-40">
    <i class="fa fa-comments text-xl"></i>
  </button>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const chatButton = document.getElementById('chatButton');
      const chatPopup = document.getElementById('chatPopup');
      const closeChat = document.getElementById('closeChat');
      const chatForm = document.getElementById('chatForm');
      const chatInput = document.getElementById('chatInput');
      const chatMessages = document.getElementById('chatMessages');

      chatButton.addEventListener('click', function() {
        chatPopup.classList.toggle('translate-y-full');
      });

      closeChat.addEventListener('click', function() {
        chatPopup.classList.add('translate-y-full');
      });

      chatForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const message = chatInput.value.trim();
        if (message) {
          addMessage('user', message);
          chatInput.value = '';
          setTimeout(() => {
            addMessage('bot', '感谢您的咨询，我们会尽快回复您！');
          }, 1000);
        }
      });

      function addMessage(type, text) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `flex mb-4 ${type === 'user' ? 'justify-end' : ''}`;
        
        if (type === 'user') {
          messageDiv.innerHTML = `
            <div class="max-w-[80%] bg-secondary text-white p-3 rounded-lg shadow-sm">
              <p>${text}</p>
            </div>
            <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center text-gray-600 ml-2 flex-shrink-0">
              <i class="fa fa-user"></i>
            </div>
          `;
        } else {
          messageDiv.innerHTML = `
            <div class="w-8 h-8 rounded-full bg-secondary flex items-center justify-center text-white mr-2 flex-shrink-0">
              <i class="fa fa-headphones"></i>
            </div>
            <div class="max-w-[80%] bg-white p-3 rounded-lg shadow-sm">
              <p>${text}</p>
            </div>
          `;
        }
        
        chatMessages.appendChild(messageDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
      }

      const contactForm = document.getElementById('contactForm');
      if (contactForm) {
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(contactForm);
          const data = Object.fromEntries(formData);
          const msgDiv = document.getElementById('contactMsg');
          try {
            const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            const result = await res.json();
            msgDiv.classList.remove('hidden', 'text-red-500');
            msgDiv.classList.add('text-green-500');
            msgDiv.textContent = result.message;
            contactForm.reset();
          } catch (err) {
            msgDiv.classList.remove('hidden', 'text-green-500');
            msgDiv.classList.add('text-red-500');
            msgDiv.textContent = '提交失败，请稍后重试';
          }
        });
      }

      if (document.getElementById('projectChart')) {
        new Chart(document.getElementById('projectChart'), {
          type: 'line',
          data: {
            labels: ['1月', '2月', '3月', '4月', '5月', '6月'],
            datasets: [{ label: '完成项目数', data: [12, 15, 18, 22, 28, 35], borderColor: '#1E5ECC', tension: 0.4, fill: true, backgroundColor: 'rgba(30,94,204,0.1)' }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      if (document.getElementById('serviceChart')) {
        new Chart(document.getElementById('serviceChart'), {
          type: 'doughnut',
          data: {
            labels: ['网站建设', '软件开发', '云服务', 'UI设计'],
            datasets: [{ data: [35, 30, 20, 15], backgroundColor: ['#1E5ECC', '#0C3B99', '#3B82F6', '#60A5FA'] }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      window.addEventListener('scroll', () => {
        const navbar = document.getElementById('navbar');
        if (window.scrollY > 50) {
          navbar.classList.add('bg-white', 'nav-shadow');
          navbar.classList.remove('bg-transparent');
        } else {
          navbar.classList.remove('bg-white', 'nav-shadow');
          navbar.classList.add('bg-transparent');
        }
      });

      // 博客功能
      const blogFilterBtns = document.querySelectorAll('.blog-filter-btn');
      const loadMoreBtn = document.getElementById('loadMoreBlogs');
      const blogContainer = document.querySelector('#blog .grid');

      if (blogFilterBtns.length > 0) {
        blogFilterBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            // 更新按钮状态
            blogFilterBtns.forEach(b => {
              b.classList.remove('bg-secondary', 'text-white');
              b.classList.add('bg-gray-100', 'hover:bg-secondary', 'hover:text-white');
            });
            this.classList.remove('bg-gray-100', 'hover:bg-secondary', 'hover:text-white');
            this.classList.add('bg-secondary', 'text-white');

            // 模拟分类筛选
            const category = this.textContent.trim();
            console.log('筛选分类:', category);
            
            // 这里可以添加实际的筛选逻辑
            // 例如：过滤博客卡片，显示符合分类的内容
          });
        });
      }

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          // 显示加载状态
          this.innerHTML = '<span>加载中...</span><i class="fa fa-spinner fa-spin ml-2"></i>';
          this.disabled = true;

          // 模拟加载延迟
          setTimeout(() => {
            // 这里可以添加实际的加载更多逻辑
            // 例如：从服务器获取更多博客数据并添加到页面
            
            // 恢复按钮状态
            this.innerHTML = '<span>加载更多博客</span><i class="fa fa-refresh ml-2"></i>';
            this.disabled = false;
            
            // 显示提示
            const notification = document.createElement('div');
            notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg shadow-lg fade-in';
            notification.textContent = '已加载全部博客';
            document.body.appendChild(notification);
            
            setTimeout(() => {
              notification.remove();
            }, 3000);
          }, 1500);
        });
      }

      // 为博客卡片添加进入动画
      if (blogContainer) {
        const blogCards = blogContainer.querySelectorAll('[class*="group"]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('scale-in');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        blogCards.forEach(card => {
          observer.observe(card);
        });
      }
    });
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>极客云科网络科技工作室 - 专业技术服务提供商</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#0F172A',
            secondary: '#1E5ECC',
            tertiary: '#0C3B99',
            light: '#F8FAFC',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      }
    }
  </script>
  <style type="text/tailwindcss">
    @layer utilities {
      .content-auto { content-visibility: auto; }
      .nav-shadow { box-shadow: 0 2px 20px rgba(0,0,0,0.1); }
      .section-padding { @apply py-16 md:py-24; }
      .logo-scale { transition: transform 0.3s ease; }
      .logo-scale:hover { transform: scale(1.05); }
      .logo-bg-transparent { background-color: transparent !important; }
      .blog-card-hover { @apply transition-all duration-300 hover:shadow-xl hover:-translate-y-1; }
      .chat-popup { @apply fixed bottom-6 right-6 z-50 w-80 md:w-96 bg-white rounded-xl shadow-2xl overflow-hidden transform transition-transform duration-300; }
      .support-badge { @apply inline-flex items-center px-3 py-1 rounded-full text-sm font-medium; }
      .support-online { @apply bg-green-100 text-green-800; }
      .support-offline { @apply bg-gray-100 text-gray-800; }
      .animate-spin-slow { animation: spin 2s linear infinite; }
      .fade-in { animation: fadeIn 0.5s ease-in-out; }
      .scale-in { animation: scaleIn 0.3s ease-out; }
      .pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.7;
      }
    }
  </style>
</head>
<body class="bg-light text-primary antialiased">
  <header id="navbar" class="fixed w-full top-0 z-50 transition-all duration-300 bg-transparent">
    <div class="container mx-auto px-4 md:px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 logo-scale">
        <img src="https://p3-flow-imagex-download-sign.byteimg.com/tos-cn-i-a9rns2rl98/4fe8b4adb196462fab709caf673883ba.png~tplv-a9rns2rl98-24:720:720.png?lk3s=8e244e95&rcl=20260419185949BC52F1D1680F26C977D8&rrcfp=8a172a1a&x-expires=1777201189&x-signature=rMYauqu5Qa92QPGHBhgBdJg2JSM%3D" alt="极客云科网络科技工作室" class="h-10 w-auto md:h-12 logo-bg-transparent">
        <span class="hidden md:block text-[clamp(1.2rem,2vw,1.5rem)] font-bold text-primary">极客云科</span>
      </a>
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="hover:text-secondary transition-colors">首页</a>
        <a href="/services" class="hover:text-secondary transition-colors">服务</a>
        <a href="/about" class="hover:text-secondary transition-colors">关于</a>
        <a href="/cases" class="hover:text-secondary transition-colors">案例</a>
        <a href="/blog" class="hover:text-secondary transition-colors">博客</a>
        <a href="/data" class="hover:text-secondary transition-colors">数据中心</a>
        <a href="/contact" class="bg-secondary text-white px-5 py-2 rounded-full hover:bg-tertiary transition-all">联系我们</a>
      </nav>
      <button id="menuBtn" class="md:hidden text-xl text-primary">
        <i class="fa fa-bars"></i>
      </button>
    </div>
    <div id="mobileMenu" class="md:hidden hidden bg-white nav-shadow absolute w-full">
      <div class="container mx-auto px-4 py-4 flex flex-col gap-4">
        <a href="/" class="py-2 hover:text-secondary transition-colors">首页</a>
        <a href="/services" class="py-2 hover:text-secondary transition-colors">服务</a>
        <a href="/about" class="py-2 hover:text-secondary transition-colors">关于</a>
        <a href="/cases" class="py-2 hover:text-secondary transition-colors">案例</a>
        <a href="/blog" class="py-2 hover:text-secondary transition-colors">博客</a>
        <a href="/data" class="py-2 hover:text-secondary transition-colors">数据中心</a>
        <a href="/contact" class="bg-secondary text-white px-5 py-2 rounded-full text-center hover:bg-tertiary">联系我们</a>
      </div>
    </div>
  </header>

  <% if (page === 'home' || page === 'contact') { %>
  <section id="home" class="min-h-screen flex items-center justify-center pt-20 section-padding">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <div class="mb-8 flex justify-center">
        <img src="https://p3-flow-imagex-download-sign.byteimg.com/tos-cn-i-a9rns2rl98/4fe8b4adb196462fab709caf673883ba.png~tplv-a9rns2rl98-24:720:720.png?lk3s=8e244e95&rcl=20260419185949BC52F1D1680F26C977D8&rrcfp=8a172a1a&x-expires=1777201189&x-signature=rMYauqu5Qa92QPGHBhgBdJg2JSM%3D" alt="极客云科网络科技工作室" class="h-32 md:h-48 w-auto logo-scale logo-bg-transparent">
      </div>
      <h1 class="text-[clamp(2rem,5vw,3.5rem)] font-bold leading-tight mb-6">
        用<span class="text-secondary">极简技术</span>，创造<span class="text-secondary">极致价值</span>
      </h1>
      <p class="text-gray-600 text-lg md:text-xl max-w-2xl mx-auto mb-10">
        极客云科网络科技工作室 | 专注软件开发、网站建设、技术解决方案，为企业提供高效极简的技术服务
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/services" class="bg-primary text-white px-8 py-3 rounded-full hover:bg-opacity-90 transition-all">查看服务</a>
        <a href="/contact" class="border-2 border-primary px-8 py-3 rounded-full hover:bg-primary hover:text-white transition-all">立即咨询</a>
      </div>
    </div>
  </section>
  <% } %>

  <% if (page === 'contact') { %>
  <section id="contact" class="section-padding bg-white">
    <div class="container mx-auto px-4 md:px-6 max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold mb-4">联系我们</h2>
        <p class="text-gray-600">有任何问题或需求，请填写下方表单，我们会尽快与您联系</p>
        <% if (support) { %>
        <div class="mt-4 flex items-center justify-center gap-2">
          <span class="support-badge <%= support.online ? 'support-online' : 'support-offline' %>">
            <i class="fa <%= support.online ? 'fa-circle' : 'fa-circle-o' %> mr-1"></i>
            <%= support.online ? '客服在线' : '客服离线' %>
          </span>
          <span class="text-gray-500 text-sm"><%= support.hours %></span>
        </div>
        <% } %>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <form id="contactForm" class="bg-gray-50 p-8 rounded-2xl">
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">您的姓名</label>
              <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondary focus:border-secondary outline-none" placeholder="请输入您的姓名">
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">邮箱地址</label>
              <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondary focus:border-secondary outline-none" placeholder="example@email.com">
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">联系电话</label>
              <input type="tel" name="phone" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondary focus:border-secondary outline-none" placeholder="请输入您的电话">
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">留言内容</label>
              <textarea name="message" rows="5" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-secondary focus:border-secondary outline-none resize-none" placeholder="请输入您想说的话..."></textarea>
            </div>
            <button type="submit" class="w-full bg-secondary text-white py-3 rounded-lg font-medium hover:bg-tertiary transition-all">提交留言</button>
            <div id="contactMsg" class="mt-4 text-center hidden"></div>
          </form>
        </div>
        <div class="space-y-8">
          <div class="bg-gray-50 p-8 rounded-2xl">
            <h3 class="text-xl font-bold mb-6">客服服务</h3>
            <% if (support) { %>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="text-2xl text-secondary mt-1"><i class="fa fa-phone"></i></div>
                <div>
                  <h4 class="font-medium">联系电话</h4>
                  <p class="text-gray-600"><%= support.phone %></p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="text-2xl text-secondary mt-1"><i class="fa fa-envelope"></i></div>
                <div>
                  <h4 class="font-medium">邮箱地址</h4>
                  <p class="text-gray-600"><%= support.email %></p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="text-2xl text-secondary mt-1"><i class="fa fa-qq"></i></div>
                <div>
                  <h4 class="font-medium">QQ</h4>
                  <p class="text-gray-600"><%= support.qq %></p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="text-2xl text-secondary mt-1"><i class="fa fa-weixin"></i></div>
                <div>
                  <h4 class="font-medium">微信</h4>
                  <p class="text-gray-600"><%= support.wechat %></p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="text-2xl text-secondary mt-1"><i class="fa fa-clock-o"></i></div>
                <div>
                  <h4 class="font-medium">服务时间</h4>
                  <p class="text-gray-600"><%= support.hours %></p>
                </div>
              </div>
            </div>
            <% } %>
          </div>
          <div class="bg-gray-50 p-8 rounded-2xl">
            <h3 class="text-xl font-bold mb-6">常见问题</h3>
            <% if (support && support.faqs && support.faqs.length > 0) { %>
            <div class="space-y-4">
              <% support.faqs.forEach(faq => { %>
              <div class="border-b border-gray-200 pb-4">
                <h4 class="font-medium mb-2"><%= faq.question %></h4>
                <p class="text-gray-600 text-sm"><%= faq.answer %></p>
              </div>
              <% }); %>
            </div>
            <% } else { %>
            <p class="text-gray-500 text-center py-4">暂无常见问题</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (page === 'services' || page === 'home') { %>
  <section id="services" class="bg-gray-50 section-padding">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold mb-4">核心服务</h2>
        <p class="text-gray-600 max-w-xl mx-auto">专注核心技术，拒绝冗余设计，为你提供高性价比的一站式技术解决方案</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (services && services.length > 0) { %>
        <% services.forEach(s => { %>
        <div class="bg-white p-8 rounded-2xl hover:shadow-lg transition-shadow">
          <div class="text-3xl text-secondary mb-4"><i class="fa <%= s.icon || 'fa-server' %>"></i></div>
          <h3 class="text-xl font-bold mb-3"><%= s.title %></h3>
          <p class="text-gray-600"><%= s.description %></p>
        </div>
        <% }); %>
        <% } else { %>
        <div class="bg-white p-8 rounded-2xl hover:shadow-lg transition-shadow">
          <div class="text-3xl text-secondary mb-4"><i class="fa fa-globe"></i></div>
          <h3 class="text-xl font-bold mb-3">网站建设</h3>
          <p class="text-gray-600">企业官网、品牌网站、响应式网站开发，极简设计，极速加载</p>
        </div>
        <div class="bg-white p-8 rounded-2xl hover:shadow-lg transition-shadow">
          <div class="text-3xl text-secondary mb-4"><i class="fa fa-code"></i></div>
          <h3 class="text-xl font-bold mb-3">软件开发</h3>
          <p class="text-gray-600">定制化系统开发、小程序开发、APP开发，高效稳定，极简操作</p>
        </div>
        <div class="bg-white p-8 rounded-2xl hover:shadow-lg transition-shadow">
          <div class="text-3xl text-secondary mb-4"><i class="fa fa-cloud"></i></div>
          <h3 class="text-xl font-bold mb-3">云服务部署</h3>
          <p class="text-gray-600">服务器配置、云平台搭建、运维托管，安全可靠，省心省力</p>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (page === 'about' || page === 'home') { %>
  <section id="about" class="section-padding">
    <div class="container mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold mb-6">关于极客云科</h2>
          <p class="text-gray-600 mb-6 leading-relaxed">
            极客云科网络科技工作室，由一群热爱技术、追求极简的极客工程师创立。我们摒弃复杂的流程和冗余的设计，专注于用最简洁的代码、最专业的技术，为中小企业、创业团队提供高性价比的技术服务。
          </p>
          <p class="text-gray-600 mb-8 leading-relaxed">
            我们的理念：<span class="text-secondary font-bold">极简、高效、专业、可靠</span>，用技术赋能业务，用细节成就品质。
          </p>
          <div class="flex gap-4">
            <div class="text-center">
              <h3 class="text-3xl font-bold text-secondary"><%= statistics?.projects || 50 %>+</h3>
              <p class="text-gray-600">完成项目</p>
            </div>
            <div class="text-center px-6 border-x border-gray-200">
              <h3 class="text-3xl font-bold text-secondary"><%= statistics?.clients || 30 %>+</h3>
              <p class="text-gray-600">合作客户</p>
            </div>
            <div class="text-center">
              <h3 class="text-3xl font-bold text-secondary">3年+</h3>
              <p class="text-gray-600">技术经验</p>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2 h-80 lg:h-96 rounded-2xl flex items-center justify-center bg-white">
          <img src="https://p3-flow-imagex-download-sign.byteimg.com/tos-cn-i-a9rns2rl98/4fe8b4adb196462fab709caf673883ba.png~tplv-a9rns2rl98-24:720:720.png?lk3s=8e244e95&rcl=20260419185949BC52F1D1680F26C977D8&rrcfp=8a172a1a&x-expires=1777201189&x-signature=rMYauqu5Qa92QPGHBhgBdJg2JSM%3D" alt="极客云科网络科技工作室" class="h-72 w-auto rounded-xl p-4 logo-bg-transparent">
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (page === 'cases' || page === 'home') { %>
  <section id="cases" class="bg-gray-50 section-padding">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold mb-4">经典案例</h2>
        <p class="text-gray-600 max-w-xl mx-auto">每一个案例，都是我们极简技术的最佳见证</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (cases && cases.length > 0) { %>
        <% cases.forEach(c => { %>
        <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-shadow">
          <div class="h-52 bg-gray-200 flex items-center justify-center"><span class="text-gray-400">案例图片</span></div>
          <div class="p-6">
            <h3 class="text-lg font-bold mb-2"><%= c.title %></h3>
            <p class="text-gray-600 text-sm"><%= c.description %></p>
          </div>
        </div>
        <% }); %>
        <% } else { %>
        <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-shadow">
          <div class="h-52 bg-gray-200 flex items-center justify-center"><span class="text-gray-400">案例图片</span></div>
          <div class="p-6"><h3 class="text-lg font-bold mb-2">企业品牌官网定制</h3><p class="text-gray-600 text-sm">高级简约风格，响应式设计，全端适配</p></div>
        </div>
        <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-shadow">
          <div class="h-52 bg-gray-200 flex items-center justify-center"><span class="text-gray-400">案例图片</span></div>
          <div class="p-6"><h3 class="text-lg font-bold mb-2">微信小程序开发</h3><p class="text-gray-600 text-sm">极简交互，高效运行，满足业务核心需求</p></div>
        </div>
        <div class="rounded-2xl overflow-hidden bg-white hover:shadow-xl transition-shadow">
          <div class="h-52 bg-gray-200 flex items-center justify-center"><span class="text-gray-400">案例图片</span></div>
          <div class="p-6"><h3 class="text-lg font-bold mb-2">管理系统定制开发</h3><p class="text-gray-600 text-sm">功能精简，操作简单，提升办公效率</p></div>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (page === 'blog' || page === 'home') { %>
  <section id="blog" class="section-padding bg-white">
    <div class="container mx-auto px-4 md:px-6">
      <div class="text-center mb-16">
        <h2 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold mb-4">技术博客</h2>
        <p class="text-gray-600 max-w-xl mx-auto">分享技术干货，探讨行业趋势，让技术更简单</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-10">
        <button class="blog-filter-btn bg-secondary text-white px-5 py-2 rounded-full transition-all duration-300 hover:shadow-md">全部</button>
        <button class="blog-filter-btn bg-gray-100 hover:bg-secondary hover:text-white px-5 py-2 rounded-full transition-all duration-300">前端开发</button>
        <button class="blog-filter-btn bg-gray-100 hover:bg-secondary hover:text-white px-5 py-2 rounded-full transition-all duration-300">后端开发</button>
        <button class="blog-filter-btn bg-gray-100 hover:bg-secondary hover:text-white px-5 py-2 rounded-full transition-all duration-300">云服务</button>
        <button class="blog-filter-btn bg-gray-100 hover:bg-secondary hover:text-white px-5 py-2 rounded-full transition-all duration-300">行业动态</button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <% if (blogPosts && blogPosts.length > 0) { %>
        <% blogPosts.forEach(b => { %>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group">
          <div class="relative h-48 overflow-hidden">
            <% if (b.image) { %>
            <img src="<%= b.image %>" alt="<%= b.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
            <% } else { %>
            <img src="https://picsum.photos/seed/<%= b.id || Math.random() %>/600/400" alt="<%= b.title %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
            <% } %>
            <div class="absolute top-4 left-4">
              <span class="bg-secondary/90 text-white text-xs px-3 py-1 rounded-full"><%= b.category %></span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center text-sm text-gray-500 mb-3">
              <span class="flex items-center mr-4"><i class="fa fa-calendar-o mr-1"></i> <%= b.date %></span>
              <span class="flex items-center"><i class="fa fa-eye mr-1"></i> 阅读 128</span>
            </div>
            <h3 class="text-xl font-bold mb-3 hover:text-secondary transition-colors group-hover:text-secondary"><%= b.title %></h3>
            <p class="text-gray-600 mb-4 line-clamp-3"><%= b.description %></p>
            <a href="#" class="text-secondary font-medium flex items-center hover:underline group-hover:translate-x-1 transition-transform">
              阅读更多 <i class="fa fa-arrow-right ml-2 text-xs transition-transform group-hover:translate-x-1"></i>
            </a>
          </div>
        </div>
        <% }); %>
        <% } else { %>
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group">
          <div class="relative h-48 overflow-hidden">

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 - 极客云科</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100">
  <div class="flex min-h-screen">
    <aside class="w-64 bg-gray-800 text-white p-6">
      <div class="mb-8">
        <h1 class="text-xl font-bold">极客云科管理后台</h1>
      </div>
      <nav class="space-y-2">
        <a href="#dashboard" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg bg-blue-600" data-section="dashboard">
          <i class="fa fa-dashboard"></i> 控制台
        </a>
        <a href="#statistics" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="statistics">
          <i class="fa fa-line-chart"></i> 数据统计
        </a>
        <a href="#services" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="services">
          <i class="fa fa-server"></i> 服务管理
        </a>
        <a href="#cases" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="cases">
          <i class="fa fa-briefcase"></i> 案例管理
        </a>
        <a href="#blog" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="blog">
          <i class="fa fa-file-text"></i> 博客管理
        </a>
        <a href="#messages" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="messages">
          <i class="fa fa-envelope"></i> 留言管理
        </a>
        <a href="#support" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="support">
          <i class="fa fa-headphones"></i> 客服服务
        </a>
        <a href="#settings" class="nav-link flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700" data-section="settings">
          <i class="fa fa-cog"></i> 账号设置
        </a>
      </nav>
      <div class="mt-8 pt-6 border-t border-gray-700">
        <a href="/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-red-600 transition">
          <i class="fa fa-sign-out"></i> 退出登录
        </a>
        <a href="/" target="_blank" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-gray-700 mt-2">
          <i class="fa fa-external-link"></i> 查看网站
        </a>
      </div>
    </aside>

    <main class="flex-1 p-8">
      <div id="dashboard" class="admin-section">
        <h2 class="text-2xl font-bold mb-6">控制台</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white p-6 rounded-xl shadow-sm">
            <div class="text-3xl font-bold text-blue-600"><%= statistics.projects %></div>
            <div class="text-gray-500">已完成项目</div>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm">
            <div class="text-3xl font-bold text-green-600"><%= statistics.clients %></div>
            <div class="text-gray-500">合作客户</div>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm">
            <div class="text-3xl font-bold text-purple-600"><%= statistics.uptime %></div>
            <div class="text-gray-500">系统稳定性</div>
          </div>
          <div class="bg-white p-6 rounded-xl shadow-sm">
            <div class="text-3xl font-bold text-orange-600"><%= statistics.satisfaction %></div>
            <div class="text-gray-500">客户满意度</div>
          </div>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-bold mb-4">最近留言</h3>
          <% if (messages.length > 0) { %>
          <div class="space-y-4">
            <% messages.slice(-5).reverse().forEach(msg => { %>
            <div class="border-l-4 <%= msg.status === 'unread' ? 'border-blue-500' : 'border-gray-300' %> pl-4 py-2">
              <div class="flex justify-between items-start">
                <div>
                  <span class="font-medium"><%= msg.name %></span>
                  <span class="text-gray-400 ml-2"><%= msg.email %></span>
                </div>
                <span class="text-sm text-gray-400"><%= new Date(msg.createdAt).toLocaleDateString('zh-CN') %></span>
              </div>
              <p class="text-gray-600 mt-1"><%= msg.message %></p>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <p class="text-gray-500 text-center py-8">暂无留言</p>
          <% } %>
        </div>
      </div>

      <div id="statistics" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">数据统计管理</h2>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <form id="statisticsForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-gray-700 font-medium mb-2">已完成项目</label>
              <input type="number" name="projects" value="<%= statistics.projects %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">合作客户</label>
              <input type="number" name="clients" value="<%= statistics.clients %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">系统稳定性 (%)</label>
              <input type="number" step="0.1" name="uptime" value="<%= statistics.uptime %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">客户满意度 (%)</label>
              <input type="number" name="satisfaction" value="<%= statistics.satisfaction %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div class="md:col-span-2">
              <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存更改</button>
            </div>
          </form>
        </div>
      </div>

      <div id="services" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">服务管理</h2>
        <div class="bg-white p-6 rounded-xl shadow-sm mb-6">
          <h3 class="text-lg font-bold mb-4">添加/编辑服务</h3>
          <form id="serviceForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <input type="hidden" name="id" id="serviceId">
            <input type="hidden" name="action" id="serviceAction" value="add">
            <input type="text" name="title" id="serviceTitle" placeholder="服务名称" required class="px-4 py-3 border border-gray-300 rounded-lg">
            <input type="text" name="icon" id="serviceIcon" placeholder="图标类名 (如: fa-globe)" class="px-4 py-3 border border-gray-300 rounded-lg">
            <input type="text" name="description" id="serviceDesc" placeholder="服务描述" class="px-4 py-3 border border-gray-300 rounded-lg">
            <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存</button>
          </form>
        </div>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-gray-600">图标</th>
                <th class="px-6 py-4 text-left text-gray-600">名称</th>
                <th class="px-6 py-4 text-left text-gray-600">描述</th>
                <th class="px-6 py-4 text-right text-gray-600">操作</th>
              </tr>
            </thead>
            <tbody id="servicesTable">
              <% if (services.length > 0) { %>
              <% services.forEach(s => { %>
              <tr class="border-t">
                <td class="px-6 py-4"><i class="fa <%= s.icon %> text-xl text-blue-600"></i></td>
                <td class="px-6 py-4 font-medium"><%= s.title %></td>
                <td class="px-6 py-4 text-gray-500"><%= s.description %></td>
                <td class="px-6 py-4 text-right">
                  <button data-action="editService" data-id="<%= s.id %>" data-title="<%= s.title %>" data-icon="<%= s.icon %>" data-description="<%= s.description %>" class="text-blue-500 hover:underline mr-4">编辑</button>
                  <button data-action="deleteService" data-id="<%= s.id %>" class="text-red-500 hover:underline">删除</button>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">暂无服务数据</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div id="cases" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">案例管理</h2>
        <div class="bg-white p-6 rounded-xl shadow-sm mb-6">
          <h3 class="text-lg font-bold mb-4">添加/编辑案例</h3>
          <form id="caseForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input type="hidden" name="id" id="caseId">
            <input type="hidden" name="action" id="caseAction" value="add">
            <input type="text" name="title" id="caseTitle" placeholder="案例名称" required class="px-4 py-3 border border-gray-300 rounded-lg">
            <input type="text" name="description" id="caseDesc" placeholder="案例描述" class="px-4 py-3 border border-gray-300 rounded-lg">
            <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存</button>
          </form>
        </div>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-gray-600">案例名称</th>
                <th class="px-6 py-4 text-left text-gray-600">描述</th>
                <th class="px-6 py-4 text-right text-gray-600">操作</th>
              </tr>
            </thead>
            <tbody id="casesTable">
              <% if (cases.length > 0) { %>
              <% cases.forEach(c => { %>
              <tr class="border-t">
                <td class="px-6 py-4 font-medium"><%= c.title %></td>
                <td class="px-6 py-4 text-gray-500"><%= c.description %></td>
                <td class="px-6 py-4 text-right">
                  <button data-action="editCase" data-id="<%= c.id %>" data-title="<%= c.title %>" data-description="<%= c.description %>" class="text-blue-500 hover:underline mr-4">编辑</button>
                  <button data-action="deleteCase" data-id="<%= c.id %>" class="text-red-500 hover:underline">删除</button>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">暂无案例数据</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div id="blog" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">博客管理</h2>
        <div class="bg-white p-6 rounded-xl shadow-sm mb-6">
          <h3 class="text-lg font-bold mb-4">添加/编辑博客</h3>
          <form id="blogForm" class="space-y-4">
            <input type="hidden" name="id" id="blogId">
            <input type="hidden" name="action" id="blogAction" value="add">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-gray-700 font-medium mb-2">博客标题</label>
                <input type="text" name="title" id="blogTitle" placeholder="输入博客标题" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">分类</label>
                <select name="category" id="blogCategory" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                  <option value="前端开发">前端开发</option>
                  <option value="后端开发">后端开发</option>
                  <option value="云服务">云服务</option>
                  <option value="行业动态">行业动态</option>
                  <option value="技术教程">技术教程</option>
                </select>
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">发布日期</label>
                <input type="date" name="date" id="blogDate" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">封面图片URL</label>
                <input type="text" name="image" id="blogImage" placeholder="输入图片URL或留空使用默认图" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
              </div>
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">博客简介</label>
              <textarea name="description" id="blogDesc" rows="3" placeholder="输入博客简介（将显示在博客列表中）" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none"></textarea>
            </div>
            <div class="flex gap-3">
              <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors">
                <i class="fa fa-save mr-2"></i>保存博客
              </button>
              <button type="button" id="cancelBlogBtn" onclick="cancelBlogEdit()" class="bg-gray-500 text-white px-6 py-3 rounded-lg hover:bg-gray-600 transition-colors hidden">
                <i class="fa fa-times mr-2"></i>取消编辑
              </button>
            </div>
          </form>
        </div>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-gray-600 font-medium">封面</th>
                <th class="px-6 py-4 text-left text-gray-600 font-medium">标题</th>
                <th class="px-6 py-4 text-left text-gray-600 font-medium">分类</th>
                <th class="px-6 py-4 text-left text-gray-600 font-medium">日期</th>
                <th class="px-6 py-4 text-right text-gray-600 font-medium">操作</th>
              </tr>
            </thead>
            <tbody id="blogTable">
              <% if (blogPosts && blogPosts.length > 0) { %>
              <% blogPosts.forEach(b => { %>
              <tr class="border-t hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="w-16 h-12 rounded-lg overflow-hidden bg-gray-200">
                    <% if (b.image) { %>
                    <img src="<%= b.image %>" alt="<%= b.title %>" class="w-full h-full object-cover">
                    <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-gray-400">
                      <i class="fa fa-image"></i>
                    </div>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="font-medium text-gray-800"><%= b.title %></div>
                  <div class="text-sm text-gray-500 truncate max-w-xs"><%= b.description %></div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= b.category %></span>
                </td>
                <td class="px-6 py-4 text-gray-500"><%= b.date %></td>
                <td class="px-6 py-4 text-right">
                  <button data-action="editBlog" data-id="<%= b.id %>" data-title="<%= b.title %>" data-category="<%= b.category %>" data-date="<%= b.date %>" data-description="<%= b.description %>" data-image="<%= b.image || '' %>" class="text-blue-600 hover:text-blue-800 mr-4 transition-colors">
                    <i class="fa fa-edit mr-1"></i>编辑
                  </button>
                  <button data-action="deleteBlog" data-id="<%= b.id %>" class="text-red-600 hover:text-red-800 transition-colors">
                    <i class="fa fa-trash mr-1"></i>删除
                  </button>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">暂无博客数据，请添加新博客</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div id="messages" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">留言管理</h2>
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-4 text-left text-gray-600">状态</th>
                <th class="px-6 py-4 text-left text-gray-600">姓名</th>
                <th class="px-6 py-4 text-left text-gray-600">邮箱</th>
                <th class="px-6 py-4 text-left text-gray-600">留言内容</th>
                <th class="px-6 py-4 text-left text-gray-600">时间</th>
                <th class="px-6 py-4 text-right text-gray-600">操作</th>
              </tr>
            </thead>
            <tbody>
              <% if (messages.length > 0) { %>
              <% messages.forEach(m => { %>
              <tr class="border-t <%= m.status === 'unread' ? 'bg-blue-50' : '' %>">
                <td class="px-6 py-4">
                  <span class="px-2 py-1 text-xs rounded-full <%= m.status === 'unread' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-600' %>">
                    <%= m.status === 'unread' ? '未读' : '已读' %>
                  </span>
                </td>
                <td class="px-6 py-4 font-medium"><%= m.name %></td>
                <td class="px-6 py-4 text-gray-500"><%= m.email %></td>
                <td class="px-6 py-4 text-gray-500 max-w-xs truncate"><%= m.message %></td>
                <td class="px-6 py-4 text-gray-500"><%= new Date(m.createdAt).toLocaleDateString('zh-CN') %></td>
                <td class="px-6 py-4 text-right">
                  <% if (m.status === 'unread') { %>
                  <button data-action="markRead" data-id="<%= m.id %>" class="text-green-500 hover:underline mr-4">标记已读</button>
                  <% } %>
                  <button data-action="deleteMessage" data-id="<%= m.id %>" class="text-red-500 hover:underline">删除</button>
                </td>
              </tr>
              <% }); %>
              <% } else { %>
              <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">暂无留言</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
    </div>

    <div id="support" class="admin-section hidden">
      <h2 class="text-2xl font-bold mb-6">客服服务管理</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-bold mb-4">客服设置</h3>
          <form id="supportForm" class="space-y-4">
            <div class="flex items-center">
              <input type="checkbox" name="online" id="supportOnline" <%= support?.online ? 'checked' : '' %> class="mr-2">
              <label for="supportOnline">客服在线</label>
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">服务时间</label>
              <input type="text" name="hours" value="<%= support?.hours || '周一至周五 9:00-18:00' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">联系电话</label>
              <input type="text" name="phone" value="<%= support?.phone || '400-123-4567' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">邮箱地址</label>
              <input type="email" name="email" value="<%= support?.email || 'support@jikecloud.com' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">QQ</label>
              <input type="text" name="qq" value="<%= support?.qq || '123456789' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">微信</label>
              <input type="text" name="wechat" value="<%= support?.wechat || 'jikecloud-service' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存设置</button>
          </form>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <h3 class="text-lg font-bold mb-4">常见问题（FAQ）</h3>
          <form id="faqForm" class="space-y-4 mb-6">
            <input type="hidden" name="id" id="faqId">
            <input type="hidden" name="action" id="faqAction" value="add">
            <div>
              <label class="block text-gray-700 font-medium mb-2">问题</label>
              <input type="text" name="question" id="faqQuestion" placeholder="输入问题" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="block text-gray-700 font-medium mb-2">答案</label>
              <textarea name="answer" id="faqAnswer" rows="3" placeholder="输入答案" class="w-full px-4 py-3 border border-gray-300 rounded-lg"></textarea>
            </div>
            <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存</button>
          </form>
          <div class="space-y-4">
            <% if (support?.faqs && support.faqs.length > 0) { %>
            <% support.faqs.forEach(faq => { %>
            <div class="border rounded-lg p-4">
              <div class="flex justify-between items-start">
                <div>
                  <h4 class="font-medium"><%= faq.question %></h4>
                  <p class="text-sm text-gray-600 mt-1"><%= faq.answer %></p>
                </div>
                <div>
                  <button data-action="editFaq" data-id="<%= faq.id %>" data-question="<%= faq.question %>" data-answer="<%= faq.answer %>" class="text-blue-500 hover:underline mr-4">编辑</button>
                  <button data-action="deleteFaq" data-id="<%= faq.id %>" class="text-red-500 hover:underline">删除</button>
                </div>
              </div>
            </div>
            <% }); %>
            <% } else { %>
            <p class="text-gray-500 text-center py-4">暂无FAQ</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div id="settings" class="admin-section hidden">
        <h2 class="text-2xl font-bold mb-6">账号设置</h2>
        <div class="bg-white p-6 rounded-xl shadow-sm">
          <form id="adminForm" class="max-w-md">
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">新用户名</label>
              <input type="text" name="username" value="<%= admin.username %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">新密码</label>
              <input type="password" name="password" placeholder="留空则不修改" class="w-full px-4 py-3 border border-gray-300 rounded-lg">
            </div>
            <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">保存更改</button>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script>
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const section = link.dataset.section;
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('bg-blue-600'));
        link.classList.add('bg-blue-600');
        document.querySelectorAll('.admin-section').forEach(s => s.classList.add('hidden'));
        document.getElementById(section).classList.remove('hidden');
      });
    });

    // 处理带有 data-action 属性的按钮点击事件
    document.addEventListener('click', (e) => {
      const button = e.target.closest('button[data-action]');
      if (!button) return;
      
      const action = button.dataset.action;
      const id = button.dataset.id;
      
      switch (action) {
        case 'editService':
          editService(id, button.dataset.title, button.dataset.icon, button.dataset.description);
          break;
        case 'deleteService':
          deleteService(id);
          break;
        case 'editCase':
          editCase(id, button.dataset.title, button.dataset.description);
          break;
        case 'deleteCase':
          deleteCase(id);
          break;
        case 'editBlog':
          editBlog(id, button.dataset.title, button.dataset.category, button.dataset.date, button.dataset.description, button.dataset.image);
          break;
        case 'deleteBlog':
          deleteBlog(id);
          break;
        case 'markRead':
          markRead(id);
          break;
        case 'deleteMessage':
          deleteMessage(id);
          break;
        case 'editFaq':
          editFaq(id, button.dataset.question, button.dataset.answer);
          break;
        case 'deleteFaq':
          deleteFaq(id);
          break;
      }
    });

    function editService(id, title, icon, description) {
      document.getElementById('serviceId').value = id;
      document.getElementById('serviceTitle').value = title;
      document.getElementById('serviceIcon').value = icon;
      document.getElementById('serviceDesc').value = description;
      document.getElementById('serviceAction').value = 'edit';
    }

    function deleteService(id) {
      if (confirm('确定删除此服务？')) {
        fetch('/admin/api/services', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id }) })
          .then(() => location.reload());
      }
    }

    function editCase(id, title, description) {
      document.getElementById('caseId').value = id;
      document.getElementById('caseTitle').value = title;
      document.getElementById('caseDesc').value = description;
      document.getElementById('caseAction').value = 'edit';
    }

    function deleteCase(id) {
      if (confirm('确定删除此案例？')) {
        fetch('/admin/api/cases', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id }) })
          .then(() => location.reload());
      }
    }

    function deleteBlog(id) {
      if (confirm('确定删除此博客？')) {
        fetch('/admin/api/blog', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id }) })
          .then(() => location.reload());
      }
    }

    function editBlog(id, title, category, date, description, image) {
      document.getElementById('blogId').value = id;
      document.getElementById('blogTitle').value = title;
      document.getElementById('blogCategory').value = category;
      document.getElementById('blogDate').value = date;
      document.getElementById('blogDesc').value = description;
      document.getElementById('blogImage').value = image || '';
      document.getElementById('blogAction').value = 'edit';
      document.getElementById('cancelBlogBtn').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cancelBlogEdit() {
      document.getElementById('blogId').value = '';
      document.getElementById('blogTitle').value = '';
      document.getElementById('blogCategory').value = '前端开发';
      document.getElementById('blogDate').value = '';
      document.getElementById('blogDesc').value = '';
      document.getElementById('blogImage').value = '';
      document.getElementById('blogAction').value = 'add';
      document.getElementById('cancelBlogBtn').classList.add('hidden');
    }

    document.getElementById('blogForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      fetch('/admin/api/blog', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(r => r.json())
        .then(d => {
          if (d.success) {
            alert(data.action === 'edit' ? '博客已更新！' : '博客已添加！');
            cancelBlogEdit();
            location.reload();
          }
        });
    });

    function markRead(id) {
      fetch('/admin/api/messages/read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) })
        .then(() => location.reload());
    }

    function deleteMessage(id) {
      if (confirm('确定删除此留言？')) {
        fetch('/admin/api/messages/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) })
          .then(() => location.reload());
      }
    }

    function editFaq(id, question, answer) {
      document.getElementById('faqId').value = id;
      document.getElementById('faqQuestion').value = question;
      document.getElementById('faqAnswer').value = answer;
      document.getElementById('faqAction').value = 'edit';
    }

    function deleteFaq(id) {
      if (confirm('确定删除此FAQ？')) {
        fetch('/admin/api/support/faq', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id }) })
          .then(() => location.reload());
      }
    }

    document.getElementById('supportForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.online = formData.get('online') === 'on';
      fetch('/admin/api/support/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(r => r.json()).then(d => { if (d.success) alert('更新成功'); });
    });

    document.getElementById('faqForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      fetch('/admin/api/support/faq', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(formData)) })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
    });

    document.getElementById('statisticsForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      fetch('/admin/api/update-statistics', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(formData)) })
        .then(r => r.json()).then(d => { if (d.success) alert('更新成功'); });
    });

    document.getElementById('adminForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      fetch('/admin/api/update-admin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(formData)) })
        .then(r => r.json()).then(d => { if (d.success) alert('更新成功'); location.reload(); });
    });
  </script>
</body>
</html>